# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
ENV/

# Test tooling
.pytest_cache/
.hypothesis/

# Secrets — NEVER commit these
.env
.env.*
*.key
*.pem
secrets.json
credentials.json

# Fixtures — real artifacts stay local
fixtures/drop/
fixtures/real/
# synthetic fixtures ARE committed
!fixtures/synthetic/

# Build artifacts — restored apps are committed as the demo surface
# (remove this exception if you only want to ship the generator)

# Evidence — large files
evidence/*/screenshots/

# Kiro runtime state (hook counters)
.kiro/state/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Docker
.docker/

# Logs
*.log
logs/

# uv / pip
uv.lock
*.whl
