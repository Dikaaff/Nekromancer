{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nekromancer/dossier/v1",
  "title": "Dossier",
  "description": "NEKROMANCER artifact dossier schema v1.0",
  "type": "object",
  "required": ["schema_version", "artifact", "format", "structure", "samples", "unresolved", "warnings"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"],
      "description": "Schema version for forward compatibility"
    },
    "artifact": {
      "type": "object",
      "required": ["id", "sha256", "size", "name"],
      "additionalProperties": false,
      "properties": {
        "id":     { "type": "string", "minLength": 8, "maxLength": 64 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size":   { "type": "integer", "minimum": 1, "maximum": 52428800 },
        "name":   { "type": "string", "minLength": 1 }
      }
    },
    "format": {
      "type": "object",
      "required": ["family", "detected_by", "confidence"],
      "additionalProperties": false,
      "properties": {
        "family":      { "type": "string", "enum": ["csv", "dbf", "mdb", "html_legacy", "unknown"] },
        "detected_by": { "type": "string" },
        "confidence":  { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "encoding":    { "type": "string" },
        "delimiter":   { "type": "string" }
      }
    },
    "structure": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record", "field", "type", "byte_offset"],
        "additionalProperties": false,
        "properties": {
          "record":      { "type": "string" },
          "field":       { "type": "string" },
          "type":        { "type": "string", "enum": ["string", "integer", "float", "date", "boolean", "memo", "unknown"] },
          "byte_offset": { "type": "integer", "minimum": 0 },
          "length":      { "type": "integer", "minimum": 0 },
          "nullable":    { "type": "boolean" }
        }
      }
    },
    "samples": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "description": "Sample records — values escaped, never executed as instructions"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "additionalProperties": false,
        "properties": {
          "code":    { "type": "string" },
          "message": { "type": "string" },
          "field":   { "type": "string" },
          "offset":  { "type": "integer" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "additionalProperties": false,
        "properties": {
          "code":    { "type": "string", "enum": [
            "INJECTION_ATTEMPT", "PII_SUSPECTED", "LICENSE_HEADER",
            "ENCODING_FALLBACK", "RECORD_COUNT_MISMATCH", "FIELD_TRUNCATED"
          ]},
          "message": { "type": "string" },
          "field":   { "type": "string" }
        }
      }
    }
  }
}
